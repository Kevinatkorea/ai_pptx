{"$schema":"http://json-schema.org/draft-07/schema#","title":"JobManifest",
 "type":"object","required":["id","status"],
 "properties":{"id":{"type":"string"},"ts":{"type":"string"},
   "page_type":{"type":"string"},
   "classify":{"type":"object","properties":{"confidence":{"type":"number"},"source":{"type":"string"}}},
   "signature":{"type":"object"},
   "kind":{"type":"string"},
   "page_count":{"type":"integer"},
   "pages":{"type":"array","items":{"type":"object","properties":{
     "index":{"type":"integer"},
     "slide_path":{"type":"string"},
     "page_type":{"type":"string"},
     "confidence":{"type":"number"},
     "source":{"type":"string"},
     "has_recipe":{"type":"boolean"}}}},
   "extracted":{"type":"object","properties":{
     "kind":{"type":"string"},"title":{"type":"string"}}},
   "source":{"type":"object","properties":{
     "path":{"type":"string"},"ext":{"type":"string"}}},
   "adapter_error":{"type":"string"},
   "transform_inputs":{"type":"object","properties":{
     "template_pptx":{"type":"string"},
     "source_slots":{"type":"object"}}},
   "transform":{"type":"object","properties":{
     "recipe":{"type":"string"},
     "out_pptx":{"type":"string"},
     "workdir":{"type":"string"},
     "error":{"type":"string"}}},
   "lint":{"type":"object"},
   "recipe_proposal":{"type":"object","properties":{
     "attempted":{"type":"boolean"},
     "ok":{"type":"boolean"},
     "recipe":{"type":"object"},
     "by":{"type":"string"},
     "reason":{"type":"string"},
     "promoted":{"type":"boolean"},
     "promoted_by":{"type":"string"},
     "promoted_path":{"type":"string"},
     "page_type_registered":{"type":"boolean"},
     "page_type_match":{"type":"object"},
     "page_type_resolution":{"type":"string"},
     "page_type_register_reason":{"type":"string"},
     "regenerated":{"type":"boolean"},
     "regenerate_reason":{"type":"string"}}},
   "status":{"enum":["ready_for_review","needs_human_approval","autofix_then_recheck","new_type_queued","recipe_promoted","approved","output_done"]},
   "notify":{"type":"object"}}}
